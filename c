#!/bin/bash
#
# Debian Mirror Fixer
# ----------------
# This script comments out the existing /etc/apt/sources.list and replaces it
# with a minimal, reliable configuration using only the official Debian CDN
# (deb.debian.org) and the security archive (security.debian.org).
#
# It uses a hash of this script's content stored in /tmp/wasRun.txt to
# prevent accidental re‑execution. If the file content is unchanged, the
# script refuses to run again.
#
# The script also sends a status report to the configured webhook.
#

set -u

# ----- Configuration -------------------------------------------------------
WEBHOOK_URL="https://webhook.site/39efcb72-40f8-4408-a4c0-0dc07f0cd12d"
WASRUN_FILE="/tmp/wasRun.txt"

# ----- Guard: avoid running twice with the same content --------------------
SCRIPT_HASH=$(sha256sum "$0" | awk '{print $1}')
if [ -f "$WASRUN_FILE" ]; then
    PREVIOUS_HASH=$(cat "$WASRUN_FILE")
    if [ "$SCRIPT_HASH" = "$PREVIOUS_HASH" ]; then
        printf 'This script has already been executed with the same content. Exiting.\n'
        exit 0
    fi
fi

# ----- Helper: send report to webhook --------------------------------------
send_report() {
    local message="$1"
    wget -nv -O- \
        --no-check-certificate \
        --header="Content-Type: text/plain" \
        --post-data="$message" \
        "$WEBHOOK_URL" >/dev/null 2>&1
}

# ----- Backup the existing sources.list ------------------------------------
if [ -f /etc/apt/sources.list ]; then
    cp /etc/apt/sources.list /etc/apt/sources.list.bak
    REPORT="Backup created: /etc/apt/sources.list.bak"
else
    REPORT="No existing /etc/apt/sources.list found."
fi

# ----- Comment out all current entries -------------------------------------
# Prepend a # to every non‑comment line, preserving the original file.
if [ -f /etc/apt/sources.list ]; then
    sed -i 's/^[^#]/# &/' /etc/apt/sources.list
    REPORT+="
All existing entries have been commented out."
else
    REPORT+="
No sources.list to comment out."
fi

# ----- Write the new, minimal mirror list ----------------------------------
# The official Debian CDN (deb.debian.org) automatically redirects to a
# nearby, up‑to‑date mirror. security.debian.org handles security updates.
cat > /etc/apt/sources.list <<'EOF'
# ------------------------------------------------------------------
# Debian mirror configuration – minimal & reliable
# Generated by mirror-fixer script on $(date '+%F %T')
# ------------------------------------------------------------------

# Main Debian archive (CDN‑backed, globally available)
deb https://deb.debian.org/debian/ bookworm main contrib non-free non-free-firmware
deb https://deb.debian.org/debian/ bookworm-updates main contrib non-free non-free-firmware

# Security updates
deb https://security.debian.org/debian-security bookworm-security main contrib non-free non-free-firmware
EOF

REPORT+="
New sources.list written with:
  - deb.debian.org (bookworm, bookworm-updates)
  - security.debian.org (bookworm-security)"

# ----- Record the hash so we don't run again with the same content ---------
echo "$SCRIPT_HASH" > "$WASRUN_FILE"
REPORT+="
Hash stored in $WASRUN_FILE"

# ----- Send the report -----------------------------------------------------
send_report "$REPORT"
printf '%s\n' "$REPORT"
